---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." path="/404/" noindex>
  <div class="narrow page-head center" style="padding-bottom:5rem">
    <p class="eyebrow">404</p>
    <h1>That page is not here</h1>
    <p class="lead">The link may be old or mistyped. Try one of these instead.</p>
    <div class="cta-row" style="margin-top:1.5rem">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/features/">Features</a>
      <a class="btn" href="/docs/">Docs</a>
      <a class="btn" href="/download/">Download</a>
    </div>
  </div>
</Base>
